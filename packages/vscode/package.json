{
  "name": "icode",
  "displayName": "iCode",
  "description": "An open-source coding agent for Visual Studio Code",
  "version": "0.0.0",
  "private": true,
  "publisher": "najmulhasan-code",
  "license": "MIT",
  "icon": "media/icode.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmulhasan-code/iCode.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "icode",
          "title": "iCode",
          "icon": "media/icode-mono.svg"
        }
      ]
    },
    "views": {
      "icode": [
        {
          "type": "webview",
          "id": "icode.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "icode.setApiKey",
        "title": "Set API Key",
        "category": "iCode"
      },
      {
        "command": "icode.clearApiKey",
        "title": "Remove API Key",
        "category": "iCode"
      },
      {
        "command": "icode.newChat",
        "title": "New Chat",
        "category": "iCode",
        "icon": "$(add)"
      },
      {
        "command": "icode.chatHistory",
        "title": "Chat History",
        "category": "iCode",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "icode.newChat",
          "when": "view == icode.chat",
          "group": "navigation@1"
        },
        {
          "command": "icode.chatHistory",
          "when": "view == icode.chat",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "iCode",
      "properties": {
        "icode.provider": {
          "type": "string",
          "scope": "application",
          "enum": [
            "anthropic",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "The Anthropic API.",
            "OpenAI, another hosted provider, or a local server with an OpenAI-compatible API."
          ],
          "default": "anthropic",
          "description": "The kind of API the model is reached through."
        },
        "icode.model": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "The model id, as the provider names it. Leave empty to use the default of the Anthropic provider. The OpenAI-compatible provider needs one."
        },
        "icode.baseUrl": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "The address of the API. Leave empty for the provider's own address. Set it for another host or a local server."
        }
      }
    }
  },
  "dependencies": {
    "@icode/core": "0.0.0",
    "@icode/protocol": "0.0.0",
    "@streamdown/code": "2.0.1",
    "@vscode/codicons": "0.0.46-24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5"
  }
}
