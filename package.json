{
  "name": "icode-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source coding agent for Visual Studio Code",
  "license": "MIT",
  "author": "Najmul Hasan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/najmulhasan-code/iCode.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint eslint.config.js vitest.config.js packages e2e",
    "format": "prettier --write \"*.{js,json}\" \"{README,CONTRIBUTING}.md\" .github packages \"e2e/*.json\" e2e/src",
    "format:check": "prettier --check \"*.{js,json}\" \"{README,CONTRIBUTING}.md\" .github packages \"e2e/*.json\" e2e/src",
    "test": "tsc --build && vitest run",
    "test:e2e": "npm run build && npm run test --workspace @icode/e2e",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.134.0",
    "@vscode/test-electron": "3.1.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
